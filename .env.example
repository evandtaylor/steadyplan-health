# Public Supabase project URL, for example:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key. Safe for browser use under Supabase RLS policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for admin reads. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Simple MVP admin gate for /admin. Replace with real auth before production.
ADMIN_PASSWORD=

# Server-only OpenAI key for admin draft generation. Never expose with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional model override for admin draft generation.
OPENAI_MODEL=
