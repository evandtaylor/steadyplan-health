# Public Supabase project URL, for example:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key. Safe for browser use under Supabase RLS policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for admin reads. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Simple MVP admin gate for /admin. Replace with real auth before production.
ADMIN_PASSWORD=

# Server-only OpenAI key for admin draft and /app plan generation.
# Never expose with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional model override for admin draft and /app plan generation.
# If blank, the app falls back to its coded default model.
OPENAI_MODEL=

# Server-only Stripe/Resend values for internal purchase notifications.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=

# Optional server-only signing secret for /app access cookies.
# If omitted, the server uses SUPABASE_SERVICE_ROLE_KEY as the signing secret.
APP_ACCESS_SESSION_SECRET=
